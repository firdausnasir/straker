// Commitment tracker — personal finance commitments (subscriptions, recurring, loans).
// SQLite — a single file DB (single-user, local; Blast Radius B1). Enums are
// stored as strings and validated at the boundary with zod (see src/lib/validation.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // File-backed DB, e.g. file:./dev.db locally or an absolute path in Docker.
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  passwordHash      String
  createdAt         DateTime           @default(now())
  commitments       Commitment[]
  pushSubscriptions PushSubscription[]
  paymentAccounts   PaymentAccount[]
  // Optional default payment account, prefilled when creating a commitment.
  // SetNull on account delete: clearing the default never orphans the user.
  defaultAccountId  String?
  defaultAccount    PaymentAccount?    @relation("DefaultAccount", fields: [defaultAccountId], references: [id], onDelete: SetNull)
  // At most one passkey per account (see Credential.userId @unique).
  credential        Credential?
}

// A funding source the user pays commitments from (e.g. "Maybank ·4242").
// Single flat layer — no nested cards. User-scoped; deleting the user cascades
// to its accounts. `last4` is an optional display-only last-4 (never a full PAN).
model PaymentAccount {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  // Optional last 4 digits only — never the full number.
  last4       String?
  commitments Commitment[]
  // Named back-relation for User.defaultAccount (keeps the implicit
  // single-relation inference from clashing with User.paymentAccounts).
  defaultFor  User[]       @relation("DefaultAccount")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([userId])
}

// A WebAuthn passkey. One per user — adding/renewing replaces the single row.
// `publicKey` is the COSE public key; `counter` guards against cloned-key
// replay (a uint32 from the authenticator, held as BigInt). The credentialId
// is the authenticator's opaque handle (base64url) and is a bearer lookup key
// for sign-in — never log it.
model Credential {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  // Comma-joined AuthenticatorTransportFuture hints (e.g. "internal,hybrid").
  transports   String?
  // User-facing label, editable in Settings.
  deviceName   String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
}

// A browser Push API subscription for one device. The endpoint is a bearer
// capability (whoever holds it can push to the device) — treat as a secret:
// never log it. Pruned automatically when the push service returns 404/410.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Commitment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  // "subscription" | "recurring" | "loan" | "other"
  type        String
  // Money is stored as integer minor units (sen/cents). NEVER float.
  amountMinor Int
  // ISO-4217 code: "MYR" | "USD". No FX — value is exact in its own currency.
  currency    String
  // Billing cycle: "weekly" | "monthly" | "quarterly" | "yearly"
  cycle       String
  nextDueDate DateTime
  // "AUTO" advances nextDueDate on/after due; "MANUAL" requires the user to renew.
  renewalMode String   @default("MANUAL")
  isActive    Boolean  @default(true)
  notes       String?

  // Optional link to the payment account this commitment is paid from. SetNull
  // on account delete: the commitment survives, just unlinked.
  accountId   String?
  account     PaymentAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  // Due-date reminder opt-in (per commitment). When enabled, a daily cron
  // pushes a reminder `reminderLeadDays` days before nextDueDate.
  reminderEnabled  Boolean @default(false)
  reminderLeadDays Int     @default(3)
  // The nextDueDate a reminder was last sent for. Sending is gated on this
  // differing from the current nextDueDate, so each due date is reminded at
  // most once and the reminder re-arms automatically when the date advances.
  reminderSentForDueDate DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, isActive, nextDueDate])
  @@index([accountId])
}
