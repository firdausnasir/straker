# SQLite — a single local file, no DB server to run. Relative paths resolve
# against the `prisma/` directory, e.g. `file:./dev.db` locally. For Docker,
# the compose file overrides this to `file:/app/data/app.db` (persistent volume).

DATABASE_URL="file:./dev.db"

# Auth.js secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-32-byte-random-hex-string"

# Public origin Auth.js uses to build login/callback URLs. REQUIRED behind a
# reverse proxy (e.g. https://commit.firdausnasir.cc), otherwise the callback
# falls back to the container's internal localhost:3000. Leave unset for direct
# local access.
# AUTH_URL="https://your.domain"

# Web Push (PWA reminders). Generate with: node scripts/setup-push-env.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Bearer that protects /api/cron/* (Vercel / Docker cron container). Match the
# value used by your scheduler.
CRON_SECRET=
